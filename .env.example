NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smatal_hr_system?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="super-secret-jwt-key"

# Storage
STORAGE_ACCESS_KEY="local-access-key"
STORAGE_SECRET_KEY="local-secret-key"
STORAGE_BUCKET="smatal-hr-documents"

# Mail
MAIL_API_KEY="test-api-key"
MAIL_FROM="no-reply@smatal.com"

# Admin Seed Data
DEFAULT_ADMIN_EMAIL="admin@smatal.com"
DEFAULT_ADMIN_PASSWORD="password"
DEFAULT_ADMIN_NAME="Super Admin"
