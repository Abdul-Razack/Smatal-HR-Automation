{
  "name": "smatal-hr-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "pnpm --filter @smatal/backend run dev",
    "dev:frontend": "pnpm --filter @smatal/frontend run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @smatal/backend run start:prod",
    "lint": "eslint \"**/*.ts\" --fix",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc -b",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.1.1",
    "@types/uuid": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "dotenv": "^17.4.2",
    "prisma": "^6.2.1"
  },
  "prisma": {
    "seed": "npx tsx database/seed/seed.ts"
  },
  "pnpm": {
    "approvedBuilds": [
      "esbuild"
    ]
  }
}
