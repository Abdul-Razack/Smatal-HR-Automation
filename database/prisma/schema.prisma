// ============================================================
// Smatal HR System — Prisma Schema
// Production Grade | PostgreSQL | Multi-Tenant SaaS
// Architecture: Clean Architecture + DDD + CQRS
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum CandidateStatus {
  DRAFT
  APPLIED
  SCREENING
  INTERVIEWING
  SELECTED
  REJECTED
  WITHDRAWN
  CONVERTED
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  NOTICE
  TERMINATED
  RESIGNED
  RETIRED
}

enum FieldDataType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  ENUM
  FILE
  JSON
}

enum FieldEntityType {
  PROFILE
  CANDIDATE
  EMPLOYEE
  LEAVE_REQUEST
  LEAVE_POLICY
}

enum ValidationRuleType {
  REQUIRED
  REGEX
  MIN_LENGTH
  MAX_LENGTH
  MIN_VALUE
  MAX_VALUE
  EMAIL
  PHONE
  CUSTOM
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
  ROLLED_BACK
}

enum DocumentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum AuditOperation {
  CREATE
  READ
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
  PUBLISH
  ARCHIVE
  GENERATE
  APPROVE
  REJECT
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  PUBLISH
  APPROVE
  EXPORT
  MANAGE
  REJECT
  ADMIN
  ACTIVATE
  TERMINATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveDurationType {
  FULL_DAY
  HALF_DAY
}

enum LeaveBalanceType {
  ACCRUED
  GRANTED
}

enum LeaveAccrualType {
  MONTHLY
  YEARLY
}

enum CarryForwardType {
  NONE
  CAPPED
  UNLIMITED
}

enum HolidayType {
  PUBLIC
  COMPANY
  OPTIONAL
}

// ============================================================
// BASE AUDIT FIELDS — embedded via @@map + inline fields
// ============================================================

// ============================================================
// SECTION 1: ORGANIZATION
// ============================================================

model Company {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @unique @db.VarChar(20)
  name       String    @db.VarChar(255)
  legalName  String?   @db.VarChar(255)
  code       String    @unique @db.VarChar(50)
  logoUrl    String?   @db.VarChar(500)
  website    String?   @db.VarChar(255)
  industry   String?   @db.VarChar(100)
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  deletedBy  String?   @db.Uuid
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String    @db.Uuid
  updatedBy  String    @db.Uuid

  // Relations
  branches          Branch[]
  departments       Department[]
  designations      Designation[]
  identityUsers     IdentityUser[]
  candidates        Candidate[]
  employees         Employee[]
  roles             Role[]
  fieldDefs         FieldDefinition[]
  templates         Template[]
  documentTypes     DocumentType[]
  workflowDefs      WorkflowDefinition[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  LeaveType         LeaveType[]
  LeavePolicy       LeavePolicy[]
  employmentHistory EmploymentHistory[]
  generatedDocs     GeneratedDocument[]
  LeaveBalance      LeaveBalance[]
  Holiday           Holiday[]
  LeaveRequest      LeaveRequest[]

  @@index([code])
  @@index([isDeleted])
  @@map("companies")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @unique @db.VarChar(20)
  companyId      String    @db.Uuid
  name           String    @db.VarChar(255)
  code           String    @db.VarChar(50)
  address        String?   @db.VarChar(500)
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  pincode        String?   @db.VarChar(20)
  isHeadquarters Boolean   @default(false)
  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?   @db.Uuid
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String    @db.Uuid
  updatedBy      String    @db.Uuid

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[]
  Holiday   Holiday[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isDeleted])
  @@map("branches")
}

model Department {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @unique @db.VarChar(20)
  companyId   String    @db.Uuid
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(50)
  description String?   @db.VarChar(500)
  parentId    String?   @db.Uuid
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   String?   @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @db.Uuid
  updatedBy   String    @db.Uuid

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@index([isDeleted])
  @@map("departments")
}

model Designation {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @unique @db.VarChar(20)
  companyId   String    @db.Uuid
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(50)
  description String?   @db.VarChar(500)
  level       Int       @default(1)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   String?   @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @db.Uuid
  updatedBy   String    @db.Uuid

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isDeleted])
  @@map("designations")
}

// ============================================================
// SECTION 2: IDENTITY & ACCESS
// ============================================================

model Profile {
  id            String    @id @default(uuid()) @db.Uuid
  firstName     String    @db.VarChar(100)
  lastName      String    @db.VarChar(100)
  personalEmail String    @unique @db.VarChar(255)
  phone         String?   @db.VarChar(30)
  dateOfBirth   DateTime? @db.Date
  gender        String?   @db.VarChar(20)
  nationality   String?   @db.VarChar(100)
  profilePhoto  String?   @db.VarChar(500)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedBy     String?   @db.Uuid
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String    @db.Uuid
  updatedBy     String    @db.Uuid

  // Relations
  identityUsers IdentityUser[]
  candidates    Candidate[]
  employees     Employee[]
  fieldValues   FieldValue[]
  generatedDocs GeneratedDocument[]

  @@index([personalEmail])
  @@index([isDeleted])
  @@map("profiles")
}

model IdentityUser {
  id                String    @id @default(uuid()) @db.Uuid
  businessId        String    @unique @db.VarChar(20)
  profileId         String    @db.Uuid
  companyId         String    @db.Uuid
  email             String    @db.VarChar(255)
  passwordHash      String    @db.VarChar(500)
  isActive          Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?   @db.VarChar(200)
  lastLoginAt       DateTime?
  loginAttempts     Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  deletedBy         String?   @db.Uuid
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String    @db.Uuid
  updatedBy         String    @db.Uuid

  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles UserRole[]

  @@unique([companyId, email])
  @@index([profileId])
  @@index([companyId])
  @@index([isDeleted])
  @@map("identity_users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @unique @db.VarChar(20)
  companyId   String    @db.Uuid
  name        String    @db.VarChar(100)
  code        String    @db.VarChar(50)
  description String?   @db.VarChar(500)
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   String?   @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @db.Uuid
  updatedBy   String    @db.Uuid

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isDeleted])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  resource    String           @db.VarChar(100)
  action      PermissionAction
  description String?          @db.VarChar(500)
  isDeleted   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())
  createdBy    String   @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  identityUserId String    @db.Uuid
  roleId         String    @db.Uuid
  assignedAt     DateTime  @default(now())
  assignedBy     String    @db.Uuid
  expiresAt      DateTime?

  identityUser IdentityUser @relation(fields: [identityUserId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([identityUserId, roleId])
  @@map("user_roles")
}

// ============================================================
// SECTION 3: HR CORE
// ============================================================

model Candidate {
  id          String          @id @default(uuid()) @db.Uuid
  businessId  String          @unique @db.VarChar(20)
  profileId   String          @db.Uuid
  companyId   String          @db.Uuid
  status      CandidateStatus @default(DRAFT)
  appliedDate DateTime?       @db.Date
  source      String?         @db.VarChar(100)
  referredBy  String?         @db.Uuid
  notes       String?         @db.Text
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?
  deletedBy   String?         @db.Uuid
  version     Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String          @db.Uuid
  updatedBy   String          @db.Uuid

  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Restrict)
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fieldValues       FieldValue[]
  workflowInstances WorkflowInstance[]
  generatedDocs     GeneratedDocument[]

  @@unique([profileId, companyId])
  @@index([companyId])
  @@index([profileId])
  @@index([status])
  @@index([isDeleted])
  @@map("candidates")
}

model Employee {
  id               String         @id @default(uuid()) @db.Uuid
  businessId       String         @unique @db.VarChar(20)
  profileId        String         @db.Uuid
  companyId        String         @db.Uuid
  branchId         String?        @db.Uuid
  departmentId     String?        @db.Uuid
  designationId    String?        @db.Uuid
  reportsToId      String?        @db.Uuid
  employeeNumber   String?        @db.VarChar(50)
  status           EmployeeStatus @default(ONBOARDING)
  joinedDate       DateTime       @db.Date
  confirmationDate DateTime?      @db.Date
  probationEndDate DateTime?      @db.Date
  terminationDate  DateTime?      @db.Date
  isDeleted        Boolean        @default(false)
  deletedAt        DateTime?
  deletedBy        String?        @db.Uuid
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String         @db.Uuid
  updatedBy        String         @db.Uuid

  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Restrict)
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch            Branch?             @relation(fields: [branchId], references: [id])
  department        Department?         @relation(fields: [departmentId], references: [id])
  designation       Designation?        @relation(fields: [designationId], references: [id])
  reportsTo         Employee?           @relation("EmployeeHierarchy", fields: [reportsToId], references: [id])
  directReports     Employee[]          @relation("EmployeeHierarchy")
  fieldValues       FieldValue[]
  workflowInstances WorkflowInstance[]
  generatedDocs     GeneratedDocument[]
  LeaveBalance      LeaveBalance[]
  LeaveRequest      LeaveRequest[]
  employmentHistory EmploymentHistory[]

  @@unique([companyId, employeeNumber])
  @@index([profileId])
  @@index([companyId])
  @@index([departmentId])
  @@index([branchId])
  @@index([designationId])
  @@index([reportsToId])
  @@index([status])
  @@index([isDeleted])
  @@map("employees")
}

model EmploymentHistory {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @db.Uuid
  companyId     String   @db.Uuid
  changeType    String   @db.VarChar(50)
  previousValue String?  @db.VarChar(500)
  newValue      String?  @db.VarChar(500)
  effectiveDate DateTime @default(now())
  notes         String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  createdBy     String   @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([companyId])
  @@index([changeType])
  @@map("employment_history")
}

// ============================================================
// SECTION 4: DYNAMIC FIELD REGISTRY
// ============================================================

model FieldDefinition {
  id           String          @id @default(uuid()) @db.Uuid
  businessId   String          @unique @db.VarChar(20)
  companyId    String?         @db.Uuid
  machineKey   String          @db.VarChar(100)
  displayName  String          @db.VarChar(255)
  description  String?         @db.VarChar(500)
  dataType     FieldDataType
  entityType   FieldEntityType
  isSystem     Boolean         @default(false)
  isRequired   Boolean         @default(false)
  defaultValue String?         @db.VarChar(500)
  displayOrder Int             @default(0)
  groupId      String?         @db.Uuid
  isActive     Boolean         @default(true)
  isDeleted    Boolean         @default(false)
  deletedAt    DateTime?
  deletedBy    String?         @db.Uuid
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdBy    String          @db.Uuid
  updatedBy    String          @db.Uuid

  company      Company?              @relation(fields: [companyId], references: [id])
  group        FieldGroup?           @relation(fields: [groupId], references: [id])
  options      FieldOption[]
  validations  FieldValidation[]
  values       FieldValue[]
  placeholders TemplatePlaceholder[]

  @@unique([machineKey, companyId])
  @@index([companyId])
  @@index([groupId])
  @@index([entityType])
  @@index([isDeleted])
  @@map("field_definitions")
}

model FieldGroup {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String?  @db.Uuid
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  displayOrder Int      @default(0)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String   @db.Uuid
  updatedBy    String   @db.Uuid

  fieldDefinitions FieldDefinition[]

  @@map("field_groups")
}

model FieldOption {
  id                String   @id @default(uuid()) @db.Uuid
  fieldDefinitionId String   @db.Uuid
  label             String   @db.VarChar(255)
  value             String   @db.VarChar(255)
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String   @db.Uuid
  updatedBy         String   @db.Uuid

  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@index([fieldDefinitionId])
  @@map("field_options")
}

model FieldValidation {
  id                String             @id @default(uuid()) @db.Uuid
  fieldDefinitionId String             @db.Uuid
  ruleType          ValidationRuleType
  ruleValue         String             @db.VarChar(500)
  errorMessage      String?            @db.VarChar(500)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String             @db.Uuid
  updatedBy         String             @db.Uuid

  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@index([fieldDefinitionId])
  @@map("field_validations")
}

model FieldValue {
  id                String          @id @default(uuid()) @db.Uuid
  fieldDefinitionId String          @db.Uuid
  companyId         String          @db.Uuid
  entityType        FieldEntityType
  entityId          String          @db.Uuid
  // Polymorphic optional FK helpers for query efficiency
  profileId         String?         @db.Uuid
  candidateId       String?         @db.Uuid
  employeeId        String?         @db.Uuid
  leaveRequestId    String?         @db.Uuid
  leavePolicyId     String?         @db.Uuid
  valueData         Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String          @db.Uuid
  updatedBy         String          @db.Uuid

  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)
  profile         Profile?        @relation(fields: [profileId], references: [id])
  candidate       Candidate?      @relation(fields: [candidateId], references: [id])
  employee        Employee?       @relation(fields: [employeeId], references: [id])
  leaveRequest    LeaveRequest?   @relation(fields: [leaveRequestId], references: [id])
  leavePolicy     LeavePolicy?    @relation(fields: [leavePolicyId], references: [id])

  @@unique([fieldDefinitionId, companyId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([profileId])
  @@index([candidateId])
  @@index([employeeId])
  @@index([leaveRequestId])
  @@index([leavePolicyId])
  @@map("field_values")
}

// ============================================================
// SECTION 5: DOCUMENT TYPE & TEMPLATE ENGINE
// ============================================================

model DocumentType {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @unique @db.VarChar(20)
  companyId   String    @db.Uuid
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   String?   @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @db.Uuid
  updatedBy   String    @db.Uuid

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  templates     Template[]
  generatedDocs GeneratedDocument[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isDeleted])
  @@map("document_types")
}

model Template {
  id             String         @id @default(uuid()) @db.Uuid
  businessId     String         @unique @db.VarChar(20)
  companyId      String         @db.Uuid
  documentTypeId String         @db.Uuid
  name           String         @db.VarChar(255)
  description    String?        @db.VarChar(500)
  status         TemplateStatus @default(DRAFT)
  isDeleted      Boolean        @default(false)
  deletedAt      DateTime?
  deletedBy      String?        @db.Uuid
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String         @db.Uuid
  updatedBy      String         @db.Uuid

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documentType DocumentType      @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  versions     TemplateVersion[]

  @@index([companyId])
  @@index([documentTypeId])
  @@index([isDeleted])
  @@map("templates")
}

model TemplateVersion {
  id            String                @id @default(uuid()) @db.Uuid
  businessId    String                @unique @db.VarChar(20)
  templateId    String                @db.Uuid
  versionNumber Int
  content       String                @default("") @db.Text
  contentType   String                @default("html") @db.VarChar(20)
  status        TemplateVersionStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedBy   String?               @db.Uuid
  notes         String?               @db.VarChar(500)
  isDeleted     Boolean               @default(false)
  deletedAt     DateTime?
  deletedBy     String?               @db.Uuid
  version       Int                   @default(1)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  createdBy     String                @db.Uuid
  updatedBy     String                @db.Uuid

  // V2: DOCX Import fields (all optional for backward compatibility)
  storageUri       String? @db.VarChar(1000)
  originalFilename String? @db.VarChar(500)
  mimeType         String? @db.VarChar(100)
  fileSize         Int?
  checksum         String? @db.VarChar(64)
  placeholderCount Int?
  importStatus     String? @db.VarChar(20)

  template      Template              @relation(fields: [templateId], references: [id], onDelete: Restrict)
  placeholders  TemplatePlaceholder[]
  generatedDocs GeneratedDocument[]

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@index([status])
  @@index([importStatus])
  @@index([isDeleted])
  @@map("template_versions")
}

model TemplatePlaceholder {
  id                String   @id @default(uuid()) @db.Uuid
  templateVersionId String   @db.Uuid
  fieldDefinitionId String?  @db.Uuid
  placeholderKey    String   @db.VarChar(100)
  isRequired        Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String   @db.Uuid
  updatedBy         String   @db.Uuid

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition? @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)

  @@unique([templateVersionId, placeholderKey])
  @@index([templateVersionId])
  @@index([fieldDefinitionId])
  @@map("template_placeholders")
}

// ============================================================
// SECTION 6: WORKFLOW ENGINE
// ============================================================

model WorkflowDefinition {
  id          String         @id @default(uuid()) @db.Uuid
  businessId  String         @unique @db.VarChar(20)
  companyId   String         @db.Uuid
  name        String         @db.VarChar(255)
  description String?        @db.VarChar(500)
  entityType  String         @db.VarChar(50)
  status      WorkflowStatus @default(DRAFT)
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?
  deletedBy   String?        @db.Uuid
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String         @db.Uuid
  updatedBy   String         @db.Uuid

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stages    WorkflowStage[]
  instances WorkflowInstance[]

  @@index([companyId])
  @@index([isDeleted])
  @@map("workflow_definitions")
}

model WorkflowStage {
  id                   String   @id @default(uuid()) @db.Uuid
  workflowDefinitionId String   @db.Uuid
  name                 String   @db.VarChar(255)
  code                 String   @db.VarChar(50)
  description          String?  @db.VarChar(500)
  displayOrder         Int      @default(0)
  isTerminal           Boolean  @default(false)
  isFinal              Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String   @db.Uuid
  updatedBy            String   @db.Uuid

  workflowDefinition WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  histories          WorkflowHistory[]
  generatedDocs      GeneratedDocument[]

  @@unique([workflowDefinitionId, code])
  @@index([workflowDefinitionId])
  @@map("workflow_stages")
}

model WorkflowInstance {
  id                   String                 @id @default(uuid()) @db.Uuid
  businessId           String                 @unique @db.VarChar(20)
  workflowDefinitionId String                 @db.Uuid
  companyId            String                 @db.Uuid
  entityType           String                 @db.VarChar(50)
  entityId             String                 @db.Uuid
  candidateId          String?                @db.Uuid
  employeeId           String?                @db.Uuid
  currentStageId       String?                @db.Uuid
  status               WorkflowInstanceStatus @default(PENDING)
  startedAt            DateTime?
  completedAt          DateTime?
  isDeleted            Boolean                @default(false)
  deletedAt            DateTime?
  version              Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdBy            String                 @db.Uuid
  updatedBy            String                 @db.Uuid

  workflowDefinition WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  candidate          Candidate?          @relation(fields: [candidateId], references: [id])
  employee           Employee?           @relation(fields: [employeeId], references: [id])
  histories          WorkflowHistory[]
  generatedDocs      GeneratedDocument[]
  LeaveRequest       LeaveRequest[]

  @@index([companyId])
  @@index([workflowDefinitionId])
  @@index([currentStageId])
  @@index([candidateId])
  @@index([employeeId])
  @@index([status])
  @@index([isDeleted])
  @@map("workflow_instances")
}

model WorkflowHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  workflowInstanceId String   @db.Uuid
  stageId            String   @db.Uuid
  action             String   @db.VarChar(100)
  notes              String?  @db.Text
  performedBy        String   @db.Uuid
  performedAt        DateTime @default(now())
  metadata           Json?

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  stage            WorkflowStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@index([workflowInstanceId])
  @@index([stageId])
  @@map("workflow_history")
}

// ============================================================
// SECTION 7: DOCUMENT ENGINE
// ============================================================

model GeneratedDocument {
  id                 String                   @id @default(uuid()) @db.Uuid
  businessId         String                   @unique @db.VarChar(20)
  companyId          String                   @db.Uuid
  profileId          String                   @db.Uuid
  documentTypeId     String                   @db.Uuid
  templateVersionId  String                   @db.Uuid
  workflowInstanceId String?                  @db.Uuid
  workflowStageId    String?                  @db.Uuid
  candidateId        String?                  @db.Uuid
  employeeId         String?                  @db.Uuid
  status             DocumentGenerationStatus @default(PENDING)
  generatedAt        DateTime?
  generatedBy        String?                  @db.Uuid
  isDeleted          Boolean                  @default(false)
  deletedAt          DateTime?
  deletedBy          String?                  @db.Uuid
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  createdBy          String                   @db.Uuid
  updatedBy          String                   @db.Uuid

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profile          Profile            @relation(fields: [profileId], references: [id], onDelete: Restrict)
  documentType     DocumentType       @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  templateVersion  TemplateVersion    @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  workflowInstance WorkflowInstance?  @relation(fields: [workflowInstanceId], references: [id])
  workflowStage    WorkflowStage?     @relation(fields: [workflowStageId], references: [id])
  candidate        Candidate?         @relation(fields: [candidateId], references: [id])
  employee         Employee?          @relation(fields: [employeeId], references: [id])
  snapshots        DocumentSnapshot[]

  @@index([companyId])
  @@index([profileId])
  @@index([documentTypeId])
  @@index([templateVersionId])
  @@index([workflowInstanceId])
  @@index([candidateId])
  @@index([employeeId])
  @@index([status])
  @@index([isDeleted])
  @@map("generated_documents")
}

model DocumentSnapshot {
  id                  String   @id @default(uuid()) @db.Uuid
  generatedDocumentId String   @db.Uuid
  filePath            String   @db.VarChar(500)
  fileUrl             String?  @db.VarChar(1000)
  fileSize            Int?
  mimeType            String   @db.VarChar(100)
  checksum            String   @db.VarChar(256)
  storageProvider     String   @db.VarChar(50)
  renderedContent     String?  @db.Text
  createdAt           DateTime @default(now())
  createdBy           String   @db.Uuid

  generatedDocument GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Restrict)

  @@index([generatedDocumentId])
  @@map("document_snapshots")
}

// ============================================================
// SECTION 8: BUSINESS ID COUNTERS (Atomic sequential generator)
// ============================================================

model BusinessIdCounter {
  prefix    String   @id @db.VarChar(20)
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("business_id_counters")
}

// ============================================================
// SECTION 9: AUDIT LOG
// ============================================================

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @unique @db.VarChar(20)
  companyId        String?  @db.Uuid
  entityType       String   @db.VarChar(100)
  entityBusinessId String   @db.VarChar(100)
  action           String   @db.VarChar(50)
  performedBy      String   @db.Uuid
  performedAt      DateTime @default(now())
  beforeState      Json?
  afterState       Json?
  correlationId    String?  @db.VarChar(100)
  ipAddress        String?  @db.VarChar(50)
  remarks          String?  @db.Text

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([entityType, entityBusinessId])
  @@index([performedBy])
  @@index([performedAt])
  @@index([correlationId])
  @@map("audit_logs")
}

// ============================================================
// SECTION 10: NOTIFICATION
// ============================================================

model Notification {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @unique @db.VarChar(20)
  companyId        String   @db.Uuid
  title            String   @db.VarChar(255)
  message          String   @db.Text
  notificationType String   @db.VarChar(100)
  priority         String   @db.VarChar(20)
  recipient        String   @db.Uuid
  readStatus       Boolean  @default(false)
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([recipient])
  @@map("notifications")
}

// ============================================================
// SECTION 11: LEAVE MANAGEMENT
// ============================================================

model LeaveType {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @unique @db.VarChar(20)
  companyId   String    @db.Uuid
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(50)
  description String?   @db.VarChar(500)
  colorCode   String?   @db.VarChar(20)
  isPaid      Boolean   @default(true)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   String?   @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @db.Uuid
  updatedBy   String    @db.Uuid

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  policies LeavePolicy[]
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isDeleted])
  @@map("leave_types")
}

model LeavePolicy {
  id                   String           @id @default(uuid()) @db.Uuid
  businessId           String           @unique @db.VarChar(20)
  companyId            String           @db.Uuid
  leaveTypeId          String           @db.Uuid
  name                 String           @db.VarChar(255)
  description          String?          @db.VarChar(500)
  annualEntitlement    Decimal          @db.Decimal(10, 2)
  accrualType          LeaveAccrualType @default(YEARLY)
  carryForwardType     CarryForwardType @default(NONE)
  maxCarryForwardDays  Decimal?         @db.Decimal(10, 2)
  requiresAttachment   Boolean          @default(false)
  minDaysForAttachment Int?
  isActive             Boolean          @default(true)
  isDeleted            Boolean          @default(false)
  deletedAt            DateTime?
  deletedBy            String?          @db.Uuid
  version              Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdBy            String           @db.Uuid
  updatedBy            String           @db.Uuid

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leaveType   LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  fieldValues FieldValue[]

  @@index([companyId])
  @@index([leaveTypeId])
  @@index([isDeleted])
  @@map("leave_policies")
}

model LeaveBalance {
  id               String           @id @default(uuid()) @db.Uuid
  businessId       String           @unique @db.VarChar(20)
  companyId        String           @db.Uuid
  employeeId       String           @db.Uuid
  leaveTypeId      String           @db.Uuid
  year             Int
  balanceType      LeaveBalanceType @default(GRANTED)
  totalEntitlement Decimal          @db.Decimal(10, 2)
  accruedDays      Decimal          @default(0) @db.Decimal(10, 2)
  carriedForward   Decimal          @default(0) @db.Decimal(10, 2)
  usedDays         Decimal          @default(0) @db.Decimal(10, 2)
  pendingDays      Decimal          @default(0) @db.Decimal(10, 2)
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        String           @db.Uuid
  updatedBy        String           @db.Uuid

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  accruals      LeaveAccrual[]
  carryForwards LeaveCarryForward[]

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@map("leave_balances")
}

model Holiday {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @unique @db.VarChar(20)
  companyId   String      @db.Uuid
  name        String      @db.VarChar(255)
  date        DateTime    @db.Date
  type        HolidayType @default(PUBLIC)
  description String?     @db.VarChar(500)
  branchId    String?     @db.Uuid
  isActive    Boolean     @default(true)
  isDeleted   Boolean     @default(false)
  deletedAt   DateTime?
  deletedBy   String?     @db.Uuid
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   String      @db.Uuid
  updatedBy   String      @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@index([date])
  @@index([branchId])
  @@index([isDeleted])
  @@map("holidays")
}

model LeaveRequest {
  id                 String            @id @default(uuid()) @db.Uuid
  businessId         String            @unique @db.VarChar(20)
  companyId          String            @db.Uuid
  employeeId         String            @db.Uuid
  leaveTypeId        String            @db.Uuid
  status             LeaveStatus       @default(PENDING)
  startDate          DateTime          @db.Date
  endDate            DateTime          @db.Date
  duration           Decimal           @db.Decimal(10, 2)
  durationType       LeaveDurationType @default(FULL_DAY)
  reason             String            @db.Text
  attachmentUrl      String?           @db.VarChar(500)
  workflowInstanceId String?           @db.Uuid
  isDeleted          Boolean           @default(false)
  deletedAt          DateTime?
  deletedBy          String?           @db.Uuid
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String            @db.Uuid
  updatedBy          String            @db.Uuid

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType        LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])
  histories        LeaveHistory[]
  fieldValues      FieldValue[]

  @@index([companyId])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate])
  @@index([isDeleted])
  @@map("leave_requests")
}

model LeaveHistory {
  id             String      @id @default(uuid()) @db.Uuid
  leaveRequestId String      @db.Uuid
  status         LeaveStatus
  action         String      @db.VarChar(100)
  notes          String?     @db.Text
  performedBy    String      @db.Uuid
  performedAt    DateTime    @default(now())
  metadata       Json?

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId])
  @@map("leave_history")
}

model LeaveAccrual {
  id             String   @id @default(uuid()) @db.Uuid
  leaveBalanceId String   @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  accrualDate    DateTime @db.Date
  notes          String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  createdBy      String   @db.Uuid

  leaveBalance LeaveBalance @relation(fields: [leaveBalanceId], references: [id], onDelete: Cascade)

  @@index([leaveBalanceId])
  @@index([accrualDate])
  @@map("leave_accruals")
}

model LeaveCarryForward {
  id             String   @id @default(uuid()) @db.Uuid
  leaveBalanceId String   @db.Uuid
  fromYear       Int
  amount         Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  createdBy      String   @db.Uuid

  leaveBalance LeaveBalance @relation(fields: [leaveBalanceId], references: [id], onDelete: Cascade)

  @@index([leaveBalanceId])
  @@map("leave_carry_forwards")
}
